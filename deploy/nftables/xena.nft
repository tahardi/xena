table inet xena {}
delete table inet xena

table inet xena {
	set cut {
		type ipv4_addr
	}

	map exposed {
		type ipv4_addr . inet_service : ipv4_addr . inet_service
		flags timeout
	}

	set forwarded {
		type ipv4_addr . inet_service
		flags timeout
	}

	chain prerouting_nat {
		type nat hook prerouting priority dstnat; policy accept;
		meta l4proto tcp dnat ip to ip saddr . tcp dport map @exposed
	}

	chain input_vm {
		type filter hook input priority filter; policy accept;
		iifname != "@BRIDGE@" return
		ip saddr @cut drop
		meta pkttype { broadcast, multicast } drop
		ct state invalid drop
		meta nfproto ipv4 ct state established,related accept
		ip saddr @VM_ADDRESS@ tcp dport @PROXY_PORT@ ct state new accept
		limit rate 10/second burst 50 packets log prefix "xena-drop: " level warn
		drop
	}

	chain forward_vm {
		type filter hook forward priority filter; policy accept;
		iifname "@BRIDGE@" ip saddr @cut drop
		oifname "@BRIDGE@" ct status dnat ip saddr . tcp dport @forwarded accept
		iifname "@BRIDGE@" ct status dnat ct state established ip daddr . tcp sport @forwarded accept
		iifname "@BRIDGE@" meta pkttype { broadcast, multicast } drop
		iifname "@BRIDGE@" ct state invalid drop
		iifname "@BRIDGE@" limit rate 10/second burst 50 packets log prefix "xena-drop: " level warn
		iifname "@BRIDGE@" drop
		oifname "@BRIDGE@" drop
	}

	chain output_tokend {
		type filter hook output priority filter; policy accept;
	}

	chain tokend {
		ip daddr @VM_ADDRESS@ tcp dport 22 accept
		limit rate 10/second burst 50 packets log prefix "xena-tokend-drop: " level warn
		drop
	}
}
