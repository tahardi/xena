polkit.addRule(function (action, subject) {
  if (action.id === "org.freedesktop.systemd1.manage-units") {
    var unit = action.lookup("unit") || "";
    if (unit === "xena-cut.service" || unit === "xena-resume.service" ||
        unit.indexOf("xena-expose@") === 0 || unit.indexOf("xena-unexpose@") === 0) {
      return polkit.Result.AUTH_ADMIN;
    }
  }
});

polkit.addRule(function (action, subject) {
  if (action.id === "org.libvirt.unix.manage") {
    return subject.local && subject.active ? polkit.Result.AUTH_ADMIN_KEEP : polkit.Result.NO;
  }
});
