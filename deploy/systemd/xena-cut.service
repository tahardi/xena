[Unit]
Description=Cut the Xena VM network

[Service]
Type=oneshot
ExecStart=/usr/local/bin/xena firewall cut
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/xena
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
RestrictAddressFamilies=AF_NETLINK AF_UNIX
